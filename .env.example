# ─── App / auth ──────────────────────────────────────────────────────────────
# Local dev: the Vite proxy injects this as a Bearer token (≥16 chars). Never VITE_-prefixed.
LIQUID_BFF_DEMO_TOKEN=local-demo-token-change-me-min-16-chars
# Comma-separated origins allowed to call the BFF (same-host is always allowed).
LIQUID_INSIGHTS_APP_ORIGIN=http://localhost:5173

# Hosted deploys (Vercel): viewers enter this code to get an HttpOnly session cookie.
# Both are required in production — without them every API route fails closed (503).
LIQUID_INSIGHTS_ACCESS_CODE=
# ≥32 random chars, e.g. `openssl rand -base64 48`
LIQUID_SESSION_SECRET=
# Only set to "true" if you deliberately want the demo bearer token accepted in production.
LIQUID_ALLOW_DEMO_TOKEN=

# ─── Grok (xAI) ──────────────────────────────────────────────────────────────
# Empty = demo mode: sample answers (provider "fixture") or a source digest.
XAI_API_KEY=
XAI_MODEL=grok-4-fast-non-reasoning
XAI_TIMEOUT_MS=12000

# ─── Connectors (read-only; sample data when empty) ─────────────────────────
LINEAR_API_KEY=
# Either a team id or key; key defaults to LIQ.
LINEAR_TEAM_ID=
LINEAR_TEAM_KEY=KAN
# Ticket moves ("Move KAN-18 to In Progress"), always behind a confirm button.
# A SEPARATE Linear key with write access; leave empty to keep the app read-only.
LINEAR_ACTIONS_API_KEY=
# Comma-separated states viewers may move tickets to (default: In Progress).
LIQUID_ACTIONS_ALLOWED_STATES=In Progress

# Fine-grained PAT, read-only: Contents, Pull requests (Checks isn't offered to PATs; public repos don't need it).
GITHUB_TOKEN=
GITHUB_REPOS=gloverthomas/meridian-saas-core,gloverthomas/meridian-saas-reporting
GITHUB_BRANCH=main
# Set to "false" to disable sample data entirely (connectors without keys become "unavailable").
LIQUID_INSIGHTS_ALLOW_FIXTURES=

# Local BFF port (Vite proxies /api here).
INSIGHTS_API_PORT=4200

# Time zone for chart day/week buckets (IANA name).
LIQUID_TIMEZONE=Australia/Sydney

# PostHog (live usage trends; sample data when empty). Personal API key, read-only query scope.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com
# Public project token (phc_) for the Insights question log (topics only, never question text).
POSTHOG_PROJECT_TOKEN=

# Sentry (read-only; issue summaries only). User Auth Token: org:read, project:read, event:read.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=meridian-bank
SENTRY_HOST=https://us.sentry.io

# liquid-workflow (Cursor SDK plans/evals). Bearer token from the workflow service; server-side only.
WORKFLOW_BASE_URL=http://127.0.0.1:4100
WORKFLOW_API_TOKEN=

# Slack bot (optional). From your Slack app: Basic Information → Signing Secret, OAuth & Permissions → Bot User OAuth Token.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Slack member IDs (comma-separated) allowed to press Approve / Move buttons. Empty = no buttons in Slack.
SLACK_APPROVER_IDS=
